<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- The app loads its bundled, local .NET assemblies, including ZIP-extracted files. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
